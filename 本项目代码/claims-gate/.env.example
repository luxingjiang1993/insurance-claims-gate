# Claims Gate 环境变量示例（复制为 .env 后按需填写）
# Rewrote from: REF-MISSIONS（P-CFG α：Provider 分区清单；Issue 43 / GitHub #30）
#
# 硬规则（与 USER_GUIDE §3.4 一致）：
# - 密钥唯一写处 = 本文件旁的 claims-gate/.env（勿写入作业壳 / 前端）
# - LLM Key 与 Embedding Key 必须分离；缺 embedding Key 不得静默复用 OPENAI_API_KEY
# - 供应商契约 = OpenAI-compatible（改 BASE_URL / MODEL 即可换国产或他厂端点）
# - 换模检查单见 USER_GUIDE §3.4（不另开换模大波）
# - 本波不含「连接状态」UI（属 phase2b-p-β）

# =============================================================================
# [A] 持久库（可选；不设则进程用临时库）
# =============================================================================
# CLAIMS_GATE_DB=./data/claims_gate.sqlite

# =============================================================================
# [B] LLM — OpenAI-compatible（AI 辅助建议；无 Key 时 assist 明确降级）
# =============================================================================
OPENAI_API_KEY=
# 兼容本地/云端点（Ollama / 代理 / 国产 OpenAI-compatible）；默认官方
OPENAI_BASE_URL=https://api.openai.com/v1
# Pilot 参照模型（换模后须更新手册 Provider 表，不得宣称合门禁升级）
OPENAI_MODEL=gpt-4o-mini
# 可选别名（与 OPENAI_API_KEY 二选一即可）
# CLAIMS_GATE_LLM_API_KEY=

# =============================================================================
# [C] Embedding — 与 LLM 分 Key（仅 AI 辅助检索；规则 evaluate 不依赖）
# =============================================================================
# Pilot 推荐默认 = cloud 语义 embedding
# CI / 无 Key rebuild：显式设 EMBEDDING_PROVIDER=local（确定性哈希，非语义，不得宣称语义质量）
# 切换 provider（尤其 local→cloud）后必须重新执行：
#   python scripts/rebuild_chroma_index.py
# 否则查询向量与索引不对齐
EMBEDDING_PROVIDER=cloud
# 云 embedding Key（OpenAI-compatible /embeddings）；缺 Key 不得静默复用 OPENAI_API_KEY
CLAIMS_GATE_EMBEDDING_API_KEY=
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# 本地非语义哈希（仅 CI）：EMBEDDING_PROVIDER=local

# =============================================================================
# [D] Chroma 向量索引路径（仅 assist；evaluate 不调向量）
# =============================================================================
# 持久目录默认：./data/chroma；重建：python scripts/rebuild_chroma_index.py
# CHROMA_PERSIST_DIR=./data/chroma
# CHROMA_COLLECTION=clauses_v1

# =============================================================================
# [E] 混合检索权重（W1；仅 assist；evaluate 不调用）
# =============================================================================
# 线性加权默认 keyword 0.7 / vector 0.3；含明确条款号时走关键词短路
KEYWORD_WEIGHT=0.7
VECTOR_WEIGHT=0.3
# 关闭或故障时自动关键词降级（0/false/off）
# CLAIMS_GATE_VECTOR_ENABLED=1

# =============================================================================
# [F] 本地 trace JSONL（排障回放；默认关闭，不进默认 CI）
# =============================================================================
# CLAIMS_GATE_LOCAL_TRACE=0
# CLAIMS_GATE_LOCAL_TRACE_PATH=./data/local_traces/spans.jsonl

# =============================================================================
# [G] LangSmith（Pilot 满配：Key + TRACING_V2=true 后 evaluate/assist/latch 上报）
# =============================================================================
# 无 Key 不阻塞规则路径；默认 pytest 不要求；真上报测：pytest -m langsmith_integration
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=claims-gate
# 兼容别名：LANGSMITH_API_KEY / LANGSMITH_TRACING
# OpenEval 旁路实验（不替代 machine_check；不含排行榜）：
#   python -m missions.openeval_langsmith
#   pytest -m eval_bypass -q
#   pytest tests/langsmith_integration/test_openeval_experiment_real.py -m langsmith_integration -o addopts=
