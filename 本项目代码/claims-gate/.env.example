# Claims Gate 环境变量示例（复制为 .env 后按需填写）
# Rewrote from: REF-COURSE-03, REF-MISSIONS

# SQLite 持久演示库（可选；不设则进程用临时库）
# CLAIMS_GATE_DB=./data/claims_gate.sqlite

# --- OpenAI-compatible LLM（AI 辅助建议；无 Key 时 assist 明确降级）---
OPENAI_API_KEY=
# 兼容本地/云端点（Ollama / 代理等）；默认官方
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# 可选别名（与 OPENAI_API_KEY 二选一即可）
# CLAIMS_GATE_LLM_API_KEY=

# --- 本地 trace JSONL（W0 排障；默认关闭，不进默认 CI）---
# CLAIMS_GATE_LOCAL_TRACE=0
# CLAIMS_GATE_LOCAL_TRACE_PATH=./data/local_traces/spans.jsonl

# --- LangSmith（W0 不强制；配置位预留；无 Key 不阻塞）---
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=claims-gate

# --- Chroma 向量索引（W1；仅 AI 辅助路径；规则 evaluate 不依赖）---
# 持久目录默认：./data/chroma；重建：python scripts/rebuild_chroma_index.py
# CHROMA_PERSIST_DIR=./data/chroma
# CHROMA_COLLECTION=clauses_v1
# 默认本地确定性 embedding；切换云端：EMBEDDING_PROVIDER=cloud
EMBEDDING_PROVIDER=local
# 云 embedding 与 LLM Key 分离（OpenAI-compatible /embeddings）
# CLAIMS_GATE_EMBEDDING_API_KEY=
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small

# --- 混合检索（W1；仅 assist；evaluate 不调用）---
# 线性加权默认 keyword 0.7 / vector 0.3；含明确条款号时走关键词短路
KEYWORD_WEIGHT=0.7
VECTOR_WEIGHT=0.3
# 关闭或故障时自动关键词降级（0/false/off）
# CLAIMS_GATE_VECTOR_ENABLED=1
