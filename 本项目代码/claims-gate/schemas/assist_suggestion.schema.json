{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assist_suggestion.schema.json",
  "title": "AssistSuggestion",
  "description": "AI 辅助建议结构化输出：citation 槽须含 doc_id+clause_item+doc_version 三联键；非法不可采纳（H3）。落库门另由 KB validate 执行。",
  "type": "object",
  "required": [
    "assist_invocation_id",
    "inference_track",
    "query",
    "retrieval_profile",
    "draft_text",
    "used_llm",
    "degraded",
    "citations",
    "assist_disposition"
  ],
  "properties": {
    "assist_invocation_id": { "type": "string", "minLength": 1 },
    "inference_track": {
      "type": "string",
      "enum": ["llm_optional", "deterministic"]
    },
    "query": { "type": "string", "minLength": 1 },
    "retrieval_profile": { "type": "string", "minLength": 1 },
    "draft_text": { "type": "string" },
    "used_llm": { "type": "boolean" },
    "degraded": { "type": "boolean" },
    "degrade_reason": { "type": ["string", "null"] },
    "suggested_stance": { "type": "string" },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "retrieval": { "type": "object" },
    "case_id": { "type": "string" },
    "payout_ready": { "type": "boolean", "const": false },
    "human_latch_token": { "type": ["string", "null"] },
    "human_latch_required": { "type": "boolean" },
    "human_latch_suggested": { "type": "boolean" },
    "assist_disposition": {
      "type": "string",
      "enum": ["draft", "abstain"]
    },
    "abstain_reason": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "string",
          "enum": [
            "conflict",
            "handbook_alone",
            "low_confidence",
            "citation_unfaithful"
          ]
        }
      ]
    },
    "conflict_route_id": { "type": ["string", "null"] },
    "can_external_deny": { "type": "boolean" },
    "enable_llm": { "type": "boolean" },
    "citations": {
      "type": "array",
      "items": { "$ref": "#/$defs/assist_citation" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "assist_citation": {
      "type": "object",
      "required": ["doc_id", "clause_item", "doc_version", "chunk_id", "clause_id", "quote", "score"],
      "properties": {
        "doc_id": { "type": "string", "minLength": 1 },
        "clause_item": { "type": "string", "minLength": 1 },
        "doc_version": { "type": "string", "minLength": 1 },
        "chunk_id": { "type": "string", "minLength": 1 },
        "clause_id": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "title": { "type": "string" },
        "adoptable": { "type": "boolean" },
        "reject_reason": { "type": "string" },
        "retrieval_profile": { "type": "string" },
        "effective_date": { "type": "string" },
        "authority_rank": { "type": "integer" }
      },
      "additionalProperties": true
    }
  }
}
